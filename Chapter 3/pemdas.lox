fun powerOf(base, power){
  if(power == 0){
    return 1;
  }else if(power < 0){
    var final = 1;
    for(var i = 0; i < power; i = i+1){
      final = final / base;
    }
    return final;
  }else{
    var final = 1;
    for(var i = 0; i < power; i = i+1){
      final = final * base;
    }
    return final;
  }
}

var a = 1;
var b = 2;
var c = 3;

print (a+b);
print (a+b*c);
print (a+(b*c));
print ((a+b)*c);
print (a*-1);
print(powerOf(c, b));
print(a + powerOf(c, b));